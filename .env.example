# Copy to services/api/.env and fill in values.
#
# Required (no default — the app will not start without these):
#   DATABASE_URL, SUPABASE_PROJECT_URL, ANTHROPIC_API_KEY,
#   QDRANT_URL, QDRANT_API_KEY, OPENAI_API_KEY
# Everything else has a default in services/api/app/config.py, which is the
# source of truth for names, defaults, and which models are used where.

# Comma-separated allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# Database — use the Supabase pooler URL (Session mode, port 5432 or 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase auth
SUPABASE_PROJECT_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_TTL_SECONDS=600

# --- Vector search (required) ---
QDRANT_URL=https://<cluster>.qdrant.io
QDRANT_API_KEY=

# --- OpenAI (required) ---
# Embeddings, the listwise rerank in the production pipeline, and explanations.
OPENAI_API_KEY=sk-...

# --- Anthropic (required) ---
# HyDE, the Haiku rerank path, collection scoring, and legacy chat.
ANTHROPIC_API_KEY=sk-ant-...
# Optional extra keys for per-key HyDE semaphoring: key A (above) is dedicated to
# Bible, B/C/D round-robin across the other collections. Each falls back to
# ANTHROPIC_API_KEY when unset.
ANTHROPIC_API_KEY_B=
ANTHROPIC_API_KEY_C=
ANTHROPIC_API_KEY_D=

# --- Cohere (optional, but the production pipeline uses it) ---
# First-stage per-collection rerank. Without it, run a non-Cohere pipeline config.
COHERE_API_KEY=

# --- Models (all optional; these are the defaults) ---
EMBEDDING_MODEL=text-embedding-3-large
HYDE_MODEL=claude-haiku-4-5
RERANK_MODEL=claude-haiku-4-5
RERANK_LUNA_MODEL=gpt-5.6-luna
EVALUATE_MODEL=claude-haiku-4-5
EXPLAIN_OPENAI_MODEL=gpt-5.4-mini
# Legacy chat only
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_TITLE_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=1024
CHAT_HISTORY_WINDOW=20

# Shared secret between the API host and Vercel — blocks direct API access
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=
# Keyed pseudonymization for guest IP quota identifiers.
# Falls back to INTERNAL_API_SECRET; set separately to rotate independently.
GUEST_IP_HASH_SECRET=

# Rate limiting
RATE_LIMIT_PER_MINUTE=10
DAILY_MESSAGE_QUOTA=50
