 "R9_trailing_heading": {
  "_comment": "A passage, followed by another, whose last of two or more lines is under max_chars, starts with a capital and has no final punctuation: the next section's heading glued on (C-08, Opus A-003). A block rule in these collections since 1.3a.",
  "collections": [
   "apostolic-exhortations",
   "encyclicals",
   "papal-documents"
  ],
