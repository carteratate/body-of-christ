 "R11_papal_editorial": {
  "_comment": "An editor's or translator's words in a papal passage (C-18, Opus A-010); the last pattern is an \"[N-M]\" paragraph-range marker, which only a table of contents prints.",
  "collections": [
   "apostolic-exhortations",
   "encyclicals",
   "papal-documents"
  ],
  "patterns": [
   "Holy Father addressed",
   "Translation by",
   "translation editing",
   "\\[\\d+\\s*[-–]\\s*\\d+\\](?=\\s|$)"
  ]
 },
 "R12_note_caller": {
  "_comment": "A footnote caller left in the text (C-17): Opus A-012's \"(N)\"/\"(N*)\" after a word and a digit glued after punctuation, Opus-2 B-005's number after sentence punctuation and a space (not before a Bible book), and \"[ N ]\". not_after skips a match whose preceding 16 characters end like a Scripture citation (\"Rom. i.\", \"3:16.\"). Summa brackets are summa_bracket_numbers'.",
  "skip_collections": [
   "bible",
   "canon-law",
   "summa"
  ],
  "patterns": [
   "[A-Za-z.,;\"”’)]\\(\\d{1,3}\\*?\\)",
